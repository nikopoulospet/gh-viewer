{
  "manifest_version": 3,
  "name": "gh-viewer",
  "version": "0.1.0",
  "description": "Saved GraphQL views of your GitHub issues, PRs and discussions, in the Firefox sidebar. Read-only.",
  "icons": {
    "16": "icons/app-16.png",
    "32": "icons/app-32.png",
    "48": "icons/app-48.png",
    "128": "icons/app-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://github.com/login/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar/panel.html"
  },
  "action": {
    "default_title": "Toggle the gh-viewer sidebar",
    "default_icon": {
      "16": "icons/app-16.png",
      "32": "icons/app-32.png",
      "48": "icons/app-48.png",
      "128": "icons/app-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "114"
}
